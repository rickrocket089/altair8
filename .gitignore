# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Environment secrets -- never commit real keys/passwords.
# ftp.secrets.enc.env is sops-encrypted at rest, so it's safe and re-included
# below despite matching *.env.
.env
*.env
!config/.env.example
!config/ftp.secrets.enc.env

# Docker
*.log

# Database
*.db
*.sqlite

# OS
.DS_Store
Thumbs.db

# Workspace: papers/memory are runtime-populated caches, not source -- keep
# excluded. outputs/ now holds real deliverables (website, sprint reports,
# banners, logos) and is tracked from here on.
workspace/papers/*
workspace/memory/*
!workspace/papers/.gitkeep
!workspace/memory/.gitkeep

# Sensitive personal files -- contains real PII (address, phone, birthdate),
# never commit even to a private repo.
workspace/workfiles/*.pdf
